generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Admin {
  id                 String   @id @default(cuid())
  userId             String   @unique
  passwordHash       String
  name               String   @default("Administrator")
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("admins")
}

model Session {
  id        String   @id @default(cuid())
  role      String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, role])
  @@map("sessions")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("login_attempts")
}

model AcademicYear {
  id          String                   @id @default(cuid())
  name        String                   @unique
  isCurrent   Boolean                  @default(false)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  enrollments StudentClassAssignment[]

  @@map("academic_years")
}

model ClassGroup {
  id           String                   @id @default(cuid())
  name         String                   @unique
  sortOrder    Int                      @default(0)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  deletedAt    DateTime?
  batches      Batch[]
  students     Student[]
  facultyLinks FacultyClassAssignment[]
  noticeTargets NoticeTarget[]
  homework     Homework[]
  tests        TestExam[]
  enrollments  StudentClassAssignment[]

  @@map("classes")
}

model Batch {
  id           String                   @id @default(cuid())
  name         String
  classId      String
  class        ClassGroup               @relation(fields: [classId], references: [id], onDelete: Cascade)
  capacity     Int                      @default(30)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  deletedAt    DateTime?
  students     Student[]
  facultyLinks FacultyClassAssignment[]
  homework     Homework[]
  tests        TestExam[]
  enrollments  StudentClassAssignment[]

  @@index([classId])
  @@map("batches")
}

model Subject {
  id           String                      @id @default(cuid())
  name         String                      @unique
  code         String?
  band         String                      @default("all")
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  facultyLinks FacultySubjectAssignment[]
  studentLinks StudentSubjectAssignment[]

  @@map("subjects")
}

model Student {
  id                  String                     @id @default(cuid())
  studentCode         String                     @unique
  userId              String                     @unique
  passwordHash        String
  mustChangePassword  Boolean                    @default(true)
  fullName            String
  parentName          String?
  mobile              String?
  email               String?
  photoPath           String?
  classId             String?
  class               ClassGroup?                @relation(fields: [classId], references: [id])
  batchId             String?
  batch               Batch?                     @relation(fields: [batchId], references: [id])
  board               String                     @default("GSEB")
  stream              String?
  previousSchool      String?
  status              String                     @default("active")
  lastPasswordResetAt DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  deletedAt           DateTime?
  subjects            StudentSubjectAssignment[]
  mentors             StudentFacultyAssignment[]
  homeworkTargets     HomeworkTarget[]
  submissions         HomeworkSubmission[]
  marks               TestMark[]
  testTargets         TestTarget[]
  enrollments         StudentClassAssignment[]

  @@index([classId, batchId, status])
  @@map("students")
}

model Faculty {
  id                  String                     @id @default(cuid())
  facultyCode         String                     @unique
  userId              String?                    @unique
  passwordHash        String?
  mustChangePassword  Boolean                    @default(true)
  name                String
  qualifications      String?  @db.Text
  description         String?  @db.Text
  photoPath           String?
  phone               String?
  email               String?
  visibleOnWebsite    Boolean                    @default(true)
  status              String                     @default("active")
  displayOrder        Int                        @default(0)
  lastPasswordResetAt DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  deletedAt           DateTime?
  subjects            FacultySubjectAssignment[]
  classes             FacultyClassAssignment[]
  mentees             StudentFacultyAssignment[]
  homework            Homework[]
  tests               TestExam[]

  @@map("faculty")
}

model StudentClassAssignment {
  id             String        @id @default(cuid())
  studentId      String
  classId        String
  batchId        String?
  academicYearId String?
  isCurrent      Boolean       @default(true)
  createdAt      DateTime      @default(now())
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class          ClassGroup    @relation(fields: [classId], references: [id])
  batch          Batch?        @relation(fields: [batchId], references: [id])
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@index([studentId, isCurrent])
  @@map("student_class_assignments")
}

model StudentFacultyAssignment {
  studentId String
  facultyId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@id([studentId, facultyId])
  @@map("student_faculty_assignments")
}

model FacultyClassAssignment {
  id        String     @id @default(cuid())
  facultyId String
  classId   String
  batchId   String?
  faculty   Faculty    @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  class     ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  batch     Batch?     @relation(fields: [batchId], references: [id])

  @@index([facultyId, classId])
  @@map("faculty_class_assignments")
}

model FacultySubjectAssignment {
  facultyId String
  subjectId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([facultyId, subjectId])
  @@map("faculty_subject_assignments")
}

model StudentSubjectAssignment {
  studentId String
  subjectId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([studentId, subjectId])
  @@map("student_subject_assignments")
}

model Notice {
  id             String         @id @default(cuid())
  title          String
  description    String         @db.Text
  category       String         @default("General")
  audience       String         @default("everyone")
  priority       String         @default("normal")
  publishAt      DateTime?
  expiresAt      DateTime?
  published      Boolean        @default(false)
  attachmentPath String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  targets        NoticeTarget[]

  @@index([published, audience])
  @@map("notices")
}

model NoticeTarget {
  noticeId String
  classId  String
  notice   Notice     @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  class    ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([noticeId, classId])
  @@map("notice_targets")
}

model PromotionalBanner {
  id           String    @id @default(cuid())
  imagePath    String
  heading      String?   @db.Text
  subtitle     String?   @db.Text
  ctaText      String?
  ctaHref      String?
  displayOrder Int       @default(0)
  startDate    DateTime?
  endDate      DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("promotional_banners")
}

model Topper {
  id           String    @id @default(cuid())
  name         String
  photoPath    String?
  standard     String
  percentage   Float
  school       String?
  academicYear String
  description  String?
  featured     Boolean   @default(false)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([featured, academicYear])
  @@map("toppers")
}

model GalleryImage {
  id           String    @id @default(cuid())
  imagePath    String
  title        String?
  category     String
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("gallery_images")
}

model AdmissionEnquiry {
  id             String   @id @default(cuid())
  enquiryCode    String   @unique
  source         String   @default("admission")
  studentName    String
  parentName     String?
  mobile         String
  email          String?
  standard       String?
  board          String?
  stream         String?
  previousSchool String?
  message        String?  @db.Text
  status         String   @default("New")
  remarks        String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, standard])
  @@map("admission_enquiries")
}

model Homework {
  id             String               @id @default(cuid())
  title          String
  description    String               @db.Text
  subjectName    String
  facultyId      String?
  faculty        Faculty?             @relation(fields: [facultyId], references: [id])
  classId        String
  class          ClassGroup           @relation(fields: [classId], references: [id])
  batchId        String?
  batch          Batch?               @relation(fields: [batchId], references: [id])
  assignedDate   DateTime
  dueDate        DateTime
  attachmentPath String?
  instructions   String?              @db.Text
  allowUpload    Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  targets        HomeworkTarget[]
  submissions    HomeworkSubmission[]

  @@index([classId, batchId])
  @@map("homework")
}

model HomeworkTarget {
  homeworkId String
  studentId  String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([homeworkId, studentId])
  @@map("homework_targets")
}

model HomeworkSubmission {
  id             String    @id @default(cuid())
  homeworkId     String
  studentId      String
  homework       Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         String    @default("pending")
  text           String?   @db.Text
  attachmentPath String?
  feedback       String?   @db.Text
  submittedAt    DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([homeworkId, studentId])
  @@map("homework_submissions")
}

model TestExam {
  id           String       @id @default(cuid())
  name         String
  subjectName  String
  classId      String
  class        ClassGroup   @relation(fields: [classId], references: [id])
  batchId      String?
  batch        Batch?       @relation(fields: [batchId], references: [id])
  testDate     DateTime
  startTime    String
  durationMin  Int
  syllabus     String?      @db.Text
  instructions String?      @db.Text
  facultyId    String?
  faculty      Faculty?     @relation(fields: [facultyId], references: [id])
  status       String       @default("scheduled")
  totalMarks   Float        @default(100)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  marks        TestMark[]
  targets      TestTarget[]

  @@index([classId, testDate])
  @@map("tests")
}

model TestTarget {
  testId    String
  studentId String
  test      TestExam @relation(fields: [testId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([testId, studentId])
  @@map("test_targets")
}

model TestMark {
  id        String   @id @default(cuid())
  testId    String
  studentId String
  test      TestExam @relation(fields: [testId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks     Float
  total     Float
  feedback  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, studentId])
  @@map("test_marks")
}

model WebsiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("website_settings")
}

model WebsiteSection {
  key       String   @id
  title     String
  subtitle  String?  @db.Text
  body      String?  @db.Text
  extra     String?  @db.LongText
  updatedAt DateTime @updatedAt

  @@map("website_sections")
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorRole String
  actorId   String
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("activity_logs")
}

model PasswordResetLog {
  id        String   @id @default(cuid())
  role      String
  targetId  String
  actorId   String
  createdAt DateTime @default(now())

  @@map("password_reset_logs")
}

model Notification {
  id           String    @id @default(cuid())
  role         String
  userRecordId String
  title        String
  body         String    @db.Text
  href         String?
  readAt       DateTime?
  dedupeKey    String?
  createdAt    DateTime  @default(now())

  @@index([role, userRecordId, readAt])
  @@map("notifications")
}

model MediaFile {
  id        String   @id @default(cuid())
  folder    String
  filename  String
  mime      String
  payload   String   @db.LongText
  createdAt DateTime @default(now())

  @@index([folder])
  @@map("media_files")
}
